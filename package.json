{
  "name": "@agegr/pi-web",
  "version": "0.8.9",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:gui": "bun run --cwd packages/idd-gui build",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "test:lane": "node --experimental-strip-types packages/idd-lane/src/test-entry.ts lane",
    "test:core": "node --experimental-strip-types packages/idd-lane/src/test-entry.ts core",
    "test": "node --experimental-strip-types packages/idd-lane/src/test-entry.ts test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@simplewebauthn/server": "^14.0.3",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "js-yaml": "^5.2.3",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "jiti": "^2.7.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "workspaces": [
    "packages/*"
  ]
}
